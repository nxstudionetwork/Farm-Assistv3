DATABASE_URL=sqlite:///./farm_assist.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farm_assist

SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30
RESET_PASSWORD_TOKEN_EXPIRE_MINUTES=15

CORS_ORIGINS=["http://localhost:3000","http://localhost:5500","http://127.0.0.1:5500","http://localhost:8080","http://localhost:8000","http://<YOUR_LOCAL_IP>:8000"]

# External APIs (set keys here for production)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_MAPS_API_KEY=
OPENWEATHER_API_KEY=
WEATHER_API_KEY=
SMS_API_KEY=
EMAIL_API_KEY=
SMS_SENDER_ID=FarmAsst

# Weather API
WEATHER_API_PROVIDER=open-meteo
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

# App Settings
APP_NAME=Farm Assist
APP_VERSION=1.0.0
DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
